# Database — dùng cho chạy local (next dev ngoài Docker). Khi chạy qua
# `docker compose up`, app container tự ghép DATABASE_URL từ POSTGRES_* bên dưới
# để nối tới service `db`, giá trị ở đây sẽ bị override.
DATABASE_URL="postgresql://se_dojo:se_dojo@localhost:5432/se_dojo?schema=public"
POSTGRES_USER="se_dojo"
POSTGRES_PASSWORD="se_dojo"
POSTGRES_DB="se_dojo"

# Auth (Auth.js / NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Bắt buộc =true khi truy cập qua IP/hostname LAN thay vì localhost, nếu không
# đăng nhập sẽ lỗi "UntrustedHost"
AUTH_TRUST_HOST=true

# Port host map ra ngoài cho `docker compose up` (container luôn chạy ở 3000 bên
# trong, chỉ đổi port public-facing). Đổi sang 80/8080 nếu 3000 bị firewall/
# mạng công ty chặn.
APP_PORT="3000"

# LLM provider — any OpenAI-compatible chat completions endpoint.
# Đặt LLM_PROVIDER=mock để chạy không cần API key thật (dùng MockLLMProvider).
LLM_PROVIDER="openai-compatible"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="change-me"
LLM_MODEL="gpt-4o-mini"

# Rate limit: số lần gọi LLM tối đa mỗi user trong 1 phút
RATE_LIMIT_PER_MINUTE="20"

# Seed script: tài khoản admin đầu tiên
SEED_ADMIN_EMAIL="admin@se-dojo.local"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"
